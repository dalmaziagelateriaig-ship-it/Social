# Chiave API di Claude: creala su https://platform.claude.com/ (Impostazioni > API keys)
ANTHROPIC_API_KEY=

# Database online (Supabase > Connect > Session pooler). Vuoto = database locale in data/pglite
DATABASE_URL=
# Archivio foto e video online (Supabase > Project Settings > API). Vuoto = cartella data/media
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Immagini con AI: basta UNA di queste due chiavi.
# OpenAI (modello gpt-image-1): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (modello gemini-2.5-flash-image): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Facoltativo: forza il servizio (openai | google) o il modello
# IMAGE_PROVIDER=
# IMAGE_MODEL=

# Facoltativo: dove salvare foto e video (di default data/media)
# MEDIA_PATH=

# Password per entrare nell'app quando è online (vuoto = nessuna password, va bene in locale)
APP_PASSWORD=

# Collegamento social (vedi README, "Collegare Facebook, Instagram e TikTok")
# Indirizzo pubblico dell'app (su Render si imposta da solo)
# PUBLIC_BASE_URL=https://social-studio.onrender.com
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Parola segreta per /api/cron (pubblicazione programmata chiamata da cron-job.org)
CRON_SECRET=
# Fuso orario degli orari nel calendario (di default Europe/Rome)
# APP_TIMEZONE=Europe/Rome
